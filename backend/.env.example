# ==========================================
# SHOPNEST Backend Environment Variables
# Copy this file to .env for local development
# ==========================================

# Django Configuration
SECRET_KEY=django-insecure-your-secret-key-here-generate-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Local PostgreSQL Database Configuration
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Production Database URL (e.g. Render / Supabase PostgreSQL)
# When set, overrides DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT
# DATABASE_URL=postgresql://user:password@host:port/database

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
